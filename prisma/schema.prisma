generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  STAFF
  DOCTOR
  ADMIN
}

enum HospitalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  name          String?
  phone         String?       @unique
  role          Role          @default(PATIENT)
  requestedRole Role?
  appointments  Appointment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  doctorProfile Doctor?
}

model Hospital {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  city      String
  state     String
  address   String
  phone     String
  status    HospitalStatus @default(PENDING)
  doctors   Doctor[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([city])
}

model Doctor {
  id              String        @id @default(uuid())
  hospitalId      String
  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name            String
  qualification   String?
  experienceYears Int?
  isActive        Boolean       @default(true)
  specialties     Specialty[]
  appointments    Appointment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          String?       @unique
  user            User?         @relation(fields: [userId], references: [id])

  @@index([hospitalId])
}

model Specialty {
  id      String   @id @default(uuid())
  name    String   @unique
  doctors Doctor[]
}

model Appointment {
  id        String            @id @default(uuid())
  patientId String
  patient   User              @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    Doctor            @relation(fields: [doctorId], references: [id])
  slotStart DateTime
  slotEnd   DateTime
  status    AppointmentStatus @default(BOOKED)
  reason    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([patientId])
  @@index([doctorId, slotStart])
}
